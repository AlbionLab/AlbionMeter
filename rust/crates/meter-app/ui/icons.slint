export component Icon {
    in property <string> d;
    in property <length> size: 16px;
    in property <brush> color: Theme.text;
    in property <float> stroke: 1.75;
    width: size;
    height: size;
    if d != "": Path {
        width: 100%;
        height: 100%;
        commands: root.d;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.color;
        stroke-width: root.stroke * root.size / 24;
        stroke-line-cap: round;
        fill: transparent;
    }
}
