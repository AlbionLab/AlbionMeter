// The colours, radii and type of web/src/styles.css (:root).
export global Theme {
    out property <color> bg: #0a0d13;
    out property <color> bar: #0d1119;
    out property <color> surface: #11161f;
    out property <color> surface-2: #161c27;
    out property <color> surface-3: #1c2331;
    out property <color> hover: #182030;
    out property <color> border: #1f2734;
    out property <color> border-strong: #2b3445;
    out property <color> border-hover: #3a4558;
    out property <color> row: #19202c;
    out property <color> text: #e9ecf2;
    out property <color> text-2: #b7becb;
    out property <color> muted: #808a9b;
    out property <color> faint: #545e6f;
    out property <color> accent: #f08a24;
    out property <color> accent-hover: #f69a3e;
    out property <color> accent-ink: #1c0e00;
    out property <color> accent-soft: #f08a241c;
    out property <color> brand: #f98714;
    out property <color> good: #3ecf7a;
    out property <color> warn: #e7ad42;
    out property <color> bad: #ec6450;
    out property <color> blue: #4ea1ff;
    out property <color> violet: #a78bfa;
    out property <length> radius: 10px;
    out property <length> radius-sm: 7px;
    // Set from Rust to the first installed family of the CSS stacks (Inter / Segoe UI / system, JetBrains Mono / Cascadia Mono / Consolas).
    in-out property <string> sans: "";
    in-out property <string> mono: "";
}
