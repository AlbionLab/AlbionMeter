<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><ApplicationIcon>app.ico</ApplicationIcon></PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win'))"><ApplicationManifest>app.manifest</ApplicationManifest></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <ProjectReference Include="../AlbionMeter.Core/AlbionMeter.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../assets/game-data/maps.json" Link="assets/maps.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Content Include="../../assets/game-data/combat.json" Link="assets/combat.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
